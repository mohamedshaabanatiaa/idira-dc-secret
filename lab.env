# ---- Lab-wide settings: edit once, every VM reads this ------------------
# Hostname in the Secrets Manager leader certificate (set at evoke configure)
CONJUR_HOST="conjur-leader.bank.local"
CONJUR_IP="10.0.0.2"             # Secrets Manager VM (confirmed)
CONJUR_ACCOUNT="bank"
CONJUR_ADMIN_USER="admin"
CONJUR_ADMIN_PASSWORD="${CONJUR_ADMIN_PASSWORD:-}"   # prompted, never commit
CONJUR_API_PREFIX=""             # Self-Hosted: "" ; try "/api" if you get 404s

VM1_IP="10.0.0.11"               # k3s + Bank of Anthos + pet store
VM2_IP="10.0.0.12"               # Jenkins + GitLab runner
VM3_IP="10.0.0.13"               # AI agent

# GitLab project that will deploy the pet store (namespace/project on gitlab.com)
GITLAB_PROJECT_PATH="mohamedshaabanatiaa/idira-petstore-deploy"
