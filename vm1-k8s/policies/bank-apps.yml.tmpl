# Workload identities, secrets and grants for the two Kubernetes apps.
# Loaded into the root branch.
- !policy
  id: bank
  body:
  # ---- Workload identities (host id = identity-path + "/" + JWT sub) ----
  - !policy
    id: k8s
    body:
    - !host
      id: system:serviceaccount:__BOA_NS__:secrets-provider
      annotations:
        description: Bank of Anthos secrets sync job
    - !host
      id: system:serviceaccount:__PET_NS__:petstore-app
      annotations:
        description: Pet store app (Secretless sidecar)
    - !layer boa
    - !layer petstore
    - !grant
      role: !layer boa
      member: !host system:serviceaccount:__BOA_NS__:secrets-provider
    - !grant
      role: !layer petstore
      member: !host system:serviceaccount:__PET_NS__:petstore-app

  # ---- Secrets: one safe-like branch per app, owned by security --------
  - !policy
    id: boa
    body:
    - !variable accounts-db/username
    - !variable accounts-db/password
    - !variable accounts-db/uri
    - !variable ledger-db/username
    - !variable ledger-db/password
    - !group consumers
    - !permit
      role: !group consumers
      privileges: [ read, execute ]
      resources:
      - !variable accounts-db/username
      - !variable accounts-db/password
      - !variable accounts-db/uri
      - !variable ledger-db/username
      - !variable ledger-db/password

  - !policy
    id: petstore
    body:
    - !variable db/address
    - !variable db/username
    - !variable db/password
    - !group consumers
    - !permit
      role: !group consumers
      privileges: [ read, execute ]
      resources:
      - !variable db/address
      - !variable db/username
      - !variable db/password

  # ---- Least privilege: each app layer reads only its own secrets -------
  - !grant
    role: !group boa/consumers
    member: !layer k8s/boa
  - !grant
    role: !group petstore/consumers
    member: !layer k8s/petstore

# Allow both workloads to use the k3s JWT authenticator
- !grant
  role: !group conjur/authn-jwt/__AUTHN_ID__/apps
  members:
  - !layer bank/k8s/boa
  - !layer bank/k8s/petstore
