# Native rotation: Secrets Manager itself changes the pet store DB password
# every __ROTATION_TTL__ (ALTER ROLE + store, in one step).
# The rotator needs sibling variables url, username, password.
# Loaded into the prod branch.
- !variable petstore/db/url            # host:port/database as seen FROM THE LEADER
- !variable
  id: petstore/db/password
  annotations:
    rotation/rotator: postgresql/password
    rotation/ttl: __ROTATION_TTL__
    rotation/postgresql/password/length: 24
