# Native rotation: Secrets Manager itself changes the pet store DB password
# every __ROTATION_TTL__ (ALTER ROLE + store, in one transaction).
# Requires sibling variables url, username, password in the same policy.
# Loaded into bank/petstore.
- !variable
  id: db/url                     # host:port/database as seen FROM THE LEADER
- !variable
  id: db/password
  annotations:
    rotation/rotator: postgresql/password
    rotation/ttl: __ROTATION_TTL__
    rotation/postgresql/password/length: 24
- !permit
  role: !group consumers
  privileges: [ read, execute ]
  resource: !variable db/url
