# ---- Edit these for your Skytap lab -------------------------------------
# Hostname that appears in the Secrets Manager leader certificate (CN/SAN)
CONJUR_HOST="conjur-leader.lab.local"
# Private IP of the Secrets Manager VM (reachable from DevOps VM1)
CONJUR_IP="10.0.0.10"
# Account name chosen at leader install (evoke configure leader -a <account>)
CONJUR_ACCOUNT="bank"
CONJUR_ADMIN_USER="admin"
# Leave empty to be prompted. Never commit a real password.
CONJUR_ADMIN_PASSWORD="${CONJUR_ADMIN_PASSWORD:-}"
# Self-Hosted serves the API at the root. If you get 404s, try "/api".
CONJUR_API_PREFIX=""

# JWT authenticator service id (conjur/authn-jwt/<AUTHN_ID>)
AUTHN_ID="k3s"
# Policy branch where the Kubernetes workload hosts live
APP_IDENTITY_PATH="bank/k8s"

# ---- Kubernetes --------------------------------------------------------
BOA_NS="boa"
PET_NS="petstore"
BOA_VERSION="v0.6.11"
SP_IMAGE="cyberark/secrets-provider-for-k8s:1.11.1"
SECRETLESS_IMAGE="cyberark/secretless-broker:latest"
PET_IMAGE="cyberark/demo-app:latest"
PG_IMAGE="postgres:15"

# ---- Original hardcoded values (used by install and revert) ------------
BOA_ACCOUNTS_USER="accounts-admin"
BOA_ACCOUNTS_PASS="accounts-pwd"
BOA_ACCOUNTS_DB="accounts-db"
BOA_LEDGER_USER="admin"
BOA_LEDGER_PASS="password"
BOA_LEDGER_DB="postgresdb"
PET_DB_USER="test_app"
PET_DB_PASS="5b3e5f75cb3cdc725fe40318"
PET_DB_NAME="test_app"
PET_NODEPORT="30080"
