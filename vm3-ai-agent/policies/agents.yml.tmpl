# AI agents as first-class workload identities.
# Loaded into the root branch.
- !policy
  id: bank/agents
  body:
  - !variable
    id: anthropic-api-key
    annotations: { description: Claude API key, used only by approved agents }

  - !host
    id: support-agent
    restricted_to: [ "__VM3_IP__/32" ]     # stolen key is useless off this VM
    annotations:
      description: Customer support agent (pet store inventory)
      owner: platform-team
      agent-runtime: python + Claude API

  - !host
    id: rogue-agent
    restricted_to: [ "__VM3_IP__/32" ]
    annotations:
      description: Unapproved agent someone deployed. Has an identity, has no grants.

  - !group llm-users
  - !permit
    role: !group llm-users
    privileges: [ read, execute ]
    resource: !variable anthropic-api-key
  - !grant { role: !group llm-users, member: !host support-agent }
